# Safe — developer.safe.global -> API Keys. JWT, sent as Authorization: Bearer.
SAFE_API_KEY=

# KeeperHub — app.keeperhub.com -> Settings -> Developer -> API keys. Prefixed kh_.
KEEPERHUB_API_KEY_READ=
KEEPERHUB_API_KEY_WRITE=
KEEPERHUB_ORG_ID=
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# The Safe this instance watches. Sepolia during development.
NEXT_PUBLIC_SAFE_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_USDC_ADDRESS=

# Postgres (Neon). Stores agent intent and composed calldata before proposing.
DATABASE_URL=

# The agent's model provider.
ANTHROPIC_API_KEY=

# Safe owners 2 and 3 — testnet keys, generated locally. Owner 1 is a browser wallet.
SAFE_OWNER_B_ADDRESS=
SAFE_OWNER_B_PRIVATE_KEY=
SAFE_OWNER_C_ADDRESS=
SAFE_OWNER_C_PRIVATE_KEY=
