{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": { "includes": ["**", "!.next", "!node_modules", "!internal", "!film"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 90
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // The only !important declarations in this codebase are the two canonical ones:
      // the prefers-reduced-motion reset, which must beat any component-level
      // transition, and the [hidden] override, which must beat `display: grid`.
      // Both are the recommended patterns. The rule earns its keep nowhere else here.
      "complexity": { "noImportantStyles": "off" },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": { "level": "error", "options": { "allow": ["warn", "error"] } }
      }
    }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
